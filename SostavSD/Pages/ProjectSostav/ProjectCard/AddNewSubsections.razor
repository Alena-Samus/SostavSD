@page "/projectcard/addnewsubsections/{ProjectId:int}"

<h3>AddNewSubsections</h3>
<MudRadioGroup T="string" SelectedOption="Country" SelectedOptionChanged="OnSelectedOptionChanged">
    <MudRadio T="string" Option="@("РБ")" Color="Color.Primary">РБ</MudRadio>
    <MudRadio T="string" Option="@("РФ")" Color="Color.Primary">РФ</MudRadio>
</MudRadioGroup>

<MudText Class="ml-4">Selected Option: @Country</MudText>

<MudSelect T="ChapterModel" Label="@Localizer["chapter"]" Variant="Variant.Outlined" @bind-value="@Chapter">
	@foreach (ChapterModel chapter in chapters)
	{
		<MudSelectItem T="ChapterModel?" Value="@chapter">@chapter.ChapterName</MudSelectItem>
	}
</MudSelect>

<MudText Class="ml-4">Selected chapter: @Chapter.ChapterName</MudText>
