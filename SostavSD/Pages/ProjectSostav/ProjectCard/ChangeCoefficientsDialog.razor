<MudDialog>
	<DialogContent>

			<MudTextField T="double?" Label="@Localizer["pk1"]" @bind-Value="@PK[0]"></MudTextField>

			<MudTextField T="double?" Label="@Localizer["pk2"]" @bind-Value="@PK[1]"></MudTextField>
	</DialogContent>

	<DialogActions>
		<MudButton @onclick="Cancel">@Localizer["cancel"]</MudButton>
		<MudButton @onclick="Submit" Color="Color.Primary">@Localizer["save"]</MudButton>
	</DialogActions>
</MudDialog>