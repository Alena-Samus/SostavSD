@page "/projectcard/{ProjectId:int}"

<div>
    @* Component ProjectInfo *@
    <MudPaper>
        <MudGrid>
            <MudItem xs="1">
                <MudText Class="title">@Localizer["projectName"]</MudText>
            </MudItem>
            <MudItem xs="11">
                <MudText>@_projectModel.ProjectName</MudText>
            </MudItem>
        </MudGrid>

        <MudGrid>
            <MudItem xs="3">
                <MudGrid>
                    <MudItem xs="6">
                        <MudText Class="title">@Localizer["buildingNumber"]</MudText>
                        <MudText>@_projectModel.BuildingNumber</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Class="title">@Localizer["order"]</MudText>

                        <MudText>@_projectModel.Contract?.Order</MudText>
                    </MudItem>
                </MudGrid>
                <MudText Class="title">@Localizer["cpe"]</MudText>

                <MudText>@_projectModel.Contract?.Executor?.Surname</MudText>
                <MudText Class="title">@Localizer["constructionPhase"]</MudText>

                <MudText>@_projectModel.ConstructionPhase</MudText>
            </MudItem>
            <MudItem xs="3">
                <MudText Class="title">@Localizer["priceLevel"]</MudText>

                <MudText>@(_projectModel.PriceLevel == null ? "" : Convert.ToDateTime(_projectModel.PriceLevel).ToString(Constants.DateFormat))</MudText>
                <MudText Class="title">@Localizer["sourceOfFinancing"]</MudText>

                <MudText>@_projectModel.Contract?.SourceOfFinacing?.SourceName</MudText>

                <MudText Class="title">@Localizer["buildingZone"]</MudText>

                <MudText>@_projectModel.Contract?.BuildingZone?.BuildingZoneName</MudText>

            </MudItem>
            <MudItem xs="3">

                <MudText Class="title">@Localizer["buildingView"]</MudText>

                <MudText>@_projectModel.BuildingView?.BuildingViewName</MudText>

                <MudText Class="title">@Localizer["designStage"]</MudText>

                <MudText>@_projectModel.DesignStage?.StageName</MudText>
                <MudText Class="title">@Localizer["workSrartDate"]</MudText>

                <MudText>@(_projectModel.WorkStartDate == null ? "" : Convert.ToDateTime(_projectModel.WorkStartDate).ToString(Constants.DateFormat))</MudText>

            </MudItem>
            <MudItem xs="3">
                <MudGrid>
                    <MudItem xs="6">
                        <MudText Class="title">@Localizer["calculator"]</MudText>
                        <MudText>@calculatorName</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Class="title">@Localizer["mainDepWorker"]</MudText>

                        <MudText>@_projectModel.MainDepWorker</MudText>
                    </MudItem>
                </MudGrid>
                <MudGrid>            
                    <MudItem xs="6">
                        <MudText Class="title">@Localizer["cic"]</MudText>
                        <MudText>@_projectModel.CiCVersion</MudText>
                        <MudButton Size="Size.Small" FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" @onclick="ChangeCiC">@Localizer["changeCiC"]</MudButton>

                    </MudItem>
                </MudGrid>


            </MudItem>

        </MudGrid>

    </MudPaper>

</div>

@* Component Chapters *@

<MudGrid>
    <MudItem xs="7">
        <div>
            <MudButtonGroup Class="d-flex justify-start flex-grow-1 gap-4" OverrideStyles="false">
                <MudIconButton Class="mx-4 my-2 mt-4" Variant="Variant.Filled" Icon="@Icons.Material.Filled.LibraryAdd" Title="@Localizer["addNewProjectChapters"]" Color="Color.Success" @onclick="NavigateToPage" />
                <MudIconButton Class="mx-4 my-2 mt-4" Variant="Variant.Filled" Icon="@Icons.Material.Filled.DeleteForever" Title="@Localizer["removeProjectChapters"]" Color="Color.Error" @onclick="(e => RemoveChapters())" />
                <MudIconButton Class="mx-4 my-2 mt-4" Variant="Variant.Filled" Icon="@Icons.Material.Filled.ContentCopy" Title="@Localizer["copyProjectChapters"]" Color="Color.Success" @onclick="(e => CopyChapters())" />
            </MudButtonGroup>

            @if (subsections == null)
            {
                @Localizer["loadingdata"]
            }
            else if (subsections.Count == 0)
            {
                @Localizer["noitem"]
            }
            else
            {
                        @foreach (var item in projectChapters)
                        {

                            <MudText>@item.Chapter.ChapterName</MudText>

                            <MudTable T="SubsectionModel" Items="@item.Subsections" Bordered=true>

                                <HeaderContent>
                                    <MudTh>@Localizer["serialNumber"]</MudTh>
                                    <MudTh>@Localizer["subsectionName"]</MudTh>
                                    <MudTh>@Localizer["k1"]</MudTh>
                                    <MudTh>@Localizer["k2"]</MudTh>
                                    <MudTh>@Localizer["norm"]</MudTh>
                                    <MudTh>@Localizer["notes"]</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="@Localizer["serialNumber"]">@context.SerialNumber</MudTd>
                                    <MudTd DataLabel="@Localizer["subsectionName"]">@context.SubsectionName</MudTd>
                                    <MudTd DataLabel="@Localizer["k1"]">@context.K1</MudTd>
                                    <MudTd DataLabel="@Localizer["k2"]">@context.K2</MudTd>
                                    <MudTd DataLabel="@Localizer["norm"]">@context.Norm</MudTd>
                                    <MudTd DataLabel="@Localizer["notes"]">@context.Notes</MudTd>
                                    <MudTd>
                                        <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" @onclick="(e => EditSubsection(context.SubsectionId))" />
                                        <MudIcon Icon="@Icons.Material.Filled.FileCopy" Size="Size.Small" @onclick="(e => CopySubsection(context.SubsectionId))" />
                                        <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" @onclick="(e => RemoveSubsection(context.SubsectionId))" />
                                    </MudTd>

                                </RowTemplate>
                            </MudTable>
                        }
            }
        </div>
    </MudItem>
    <MudItem xs="5">
        <Coefficient ProjectCoefficiencets="coefficients" OHROPR1="_projectModel.ProjectK1" OHROPR2="_projectModel.ProjectK2" ProjectId="ProjectId" UpdateCoefficients="UpdateCoefficients" />
    </MudItem>
</MudGrid>

