@if (ProjectCoefficiencets == null)
	{
		@Localizer["loadingdata"]
	}
else if (ProjectCoefficiencets.Count == 0)
	{
		@Localizer["noitem"]
	}
	else
	{

	<MudGrid>
		<MudItem xs="1">
			<MudText Class="title">@Localizer["pk1"]</MudText>
			<MudText>@OHROPR1</MudText>
		</MudItem>
		<MudItem xs="1">
			<MudText Class="title">@Localizer["pk2"]</MudText>

			<MudText Style="background: yellow;">@OHROPR2</MudText>
		</MudItem>
		<MudItem xs="1">
			<MudIconButton @onclick="@(() => Edit())" Color="Color.Primary" Icon="@Icons.Material.Filled.Edit" Size="Size.Small" IconSize="Size.Small" />
		</MudItem>
	</MudGrid>



<div>
		<MudTable T="CoefficientModel" Items="@ProjectCoefficiencets" Bordered=true>

			<HeaderContent>
				<MudTh>@Localizer["coefName"]</MudTh>
				<MudTh>@Localizer["qualifier"]</MudTh>
				<MudTh>@Localizer["kOne"]</MudTh>
				<MudTh Style="background: yellow;">@Localizer["kTwo"]</MudTh>
				<MudTh Style="background: yellow;">@Localizer["pp"]</MudTh>
			</HeaderContent>
			<RowTemplate>
				<MudTd DataLabel="@Localizer["coefName"]">@context.CoefficientName</MudTd>
				<MudTd DataLabel="@Localizer["qualifier"]">@context.Qualifier</MudTd>
				<MudTd DataLabel="@Localizer["kOne"]">@context.OHROPR1</MudTd>
				<MudTd Style="background: yellow;" DataLabel="@Localizer[" kTwo"]">@context.OHROPR2</MudTd>
				<MudTd Style="background: yellow;" DataLabel="@Localizer["pp"]">@context.PlannedProfit</MudTd>

			</RowTemplate>
		</MudTable>
</div>	

	}

