@page "/sostav/newdrawing/{ProjectId:int}"

<MudButtonGroup Variant="Variant.Outlined" Color="Color.Success" OverrideStyles="false">
	<div>
		<MudIconButton Class="mx-4 my-2" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Cancel" Title="@Localizer["cancel"]" Color="Color.Info" @onclick="GoBack" />
		<MudIconButton Class="mx-4 my-2" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Save" Title="@Localizer["saveNewDrawing"]" Color="Color.Success" @onclick="Save" />

	</div>
</MudButtonGroup>

<NewDrawingsList ListNewDrawings="newList" DeleteItem="DeleteTheItem"/>

<MudIconButton Class="mx-4 my-2" Variant="Variant.Filled" Icon="@Icons.Material.Filled.AddCircleOutline" Title="@Localizer["addNewDrawing"]" Color="Color.Success" @onclick="AddItem" />


<MudGrid>
	<MudItem xs="3">
		<MudTextField T="string" Label="@Localizer["drawingName"]" @bind-Value="@newDrawing.DrawingName"></MudTextField>

	</MudItem>
	<MudItem xs="2">
		<MudTextField T="DateTime?" Format="yyyy-MM-dd" InputType="InputType.Date" Label="@Localizer["dateOfAdmissionToDepartment"]" @bind-Value="@newDrawing.DrawingDateOfAdmissionToDepartment" Variant="Variant.Outlined"></MudTextField>

	</MudItem>
	<MudItem xs="2">
		<MudTextField T="DateTime?" Format="yyyy-MM-dd" InputType="InputType.Date" Label="@Localizer["drawingReleaseDateBySchedule"]" @bind-Value="@newDrawing.DrawingReleaseDateBySchedule" Variant="Variant.Outlined"></MudTextField>

	</MudItem>
	<MudItem xs="2">
		<MudTextField T="DateTime?" Format="yyyy-MM-dd" InputType="InputType.Date" Label="@Localizer["drawingReleaseDateDepertment"]" @bind-Value="@newDrawing.DrawingReleaseDateDepertment" Variant="Variant.Outlined"></MudTextField>

	</MudItem>
</MudGrid>