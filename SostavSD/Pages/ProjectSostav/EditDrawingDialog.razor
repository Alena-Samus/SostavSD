<h3>Edit Drawing Dialog</h3>
<MudDialog>
	<DialogContent>
		<MudTextField T="string" Label="@Localizer["drawingName"]" @bind-Value="Drawing.DrawingName" Variant="Variant.Outlined" Required=true />
		<MudTextField T="DateTime?" Format="yyyy-MM-dd" InputType="InputType.Date" Label="@Localizer["dateOfAdmissionToDepartment"]" @bind-Value="@Drawing.DrawingDateOfAdmissionToDepartment" Variant="Variant.Outlined"></MudTextField>
		<MudTextField T="DateTime?" Format="yyyy-MM-dd" InputType="InputType.Date" Label="@Localizer["drawingReleaseDateDepertment"]" @bind-Value="@Drawing.DrawingReleaseDateDepertment" Variant="Variant.Outlined"></MudTextField>
		<MudTextField T="DateTime?" Format="yyyy-MM-dd" InputType="InputType.Date" Label="@Localizer["drawingReleaseDateBySchedule"]" @bind-Value="@Drawing.DrawingReleaseDateBySchedule" Variant="Variant.Outlined"></MudTextField>
		<MudSelect T="int?" Label="@Localizer["group"]" Variant="Variant.Outlined" Value="@Drawing.GroupId" ValueChanged="@(async (int? newValue) => await OnGroupSelected(newValue))">
			@foreach (var group in _groupForTable)
			{
				<MudSelectItem T="int?" Value="@group.GroupId">@group.GroupName</MudSelectItem>
			}
		</MudSelect>
		<MudTextField T="string" Label="@Localizer["estimator"]" @bind-Value="estimator" Variant="Variant.Outlined" Required=true />
	</DialogContent>

	<DialogActions>
		<MudButton @onclick="Cancel">@Localizer["cancelChanges"]</MudButton>
		<MudButton @onclick="Submit" Color="Color.Primary">@Localizer["saveChanges"]</MudButton>
	</DialogActions>
</MudDialog>