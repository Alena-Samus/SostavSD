@if (ListNewDrawings == null || ListNewDrawings.Count == 0)
{
	<tr></tr>
}
else
{
	<MudTable T="DrawingModelForList" Items="@ListNewDrawings">
            <HeaderContent>
					<MudTh>@Localizer["drawingName"]</MudTh>
					<MudTh>@Localizer["dateOfAdmissionToDepartment"]</MudTh>
					<MudTh>@Localizer["drawingReleaseDateDepertment"]</MudTh>
					<MudTh>@Localizer["drawingReleaseDateBySchedule"]</MudTh>
					<MudTh>@Localizer["group"]</MudTh>
			</HeaderContent>

			<RowTemplate>
					<MudTd DataLabel="@Localizer["drawingName"]">@context.DrawingName</MudTd>
					<MudTd DataLabel="@Localizer["dateOfAdmissionToDepartment"]">@(context.DrawingDateOfAdmissionToDepartment == null ? "" : Convert.ToDateTime(context.DrawingDateOfAdmissionToDepartment).ToString(Constants.DateFormat))</MudTd>
					<MudTd DataLabel="@Localizer["drawingReleaseDateDepertment"]">@(context.DrawingReleaseDateDepertment == null ? "" : Convert.ToDateTime(context.DrawingReleaseDateDepertment).ToString(Constants.DateFormat))</MudTd>
					<MudTd DataLabel="@Localizer["drawingReleaseDateBySchedule"]">@(context.DrawingReleaseDateBySchedule == null ? "" : Convert.ToDateTime(context.DrawingReleaseDateBySchedule).ToString(Constants.DateFormat))</MudTd>
					<MudTd DataLabel="@Localizer["group"]">@context.DeppartName</MudTd>
					<MudFab @onclick="(() => DeleteItem.InvokeAsync(context))" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Delete" Size="Size.Small" IconSize="Size.Small" />
			</RowTemplate>		

			

		</MudTable>
}