
<h3>Plan</h3>


<MudSelect T="DeppartModel" Label="@Localizer["group"]" Variant="Variant.Outlined"
	   Value="@_currentDeppart" ValueChanged="@(OnGroupSelected)"
 	   ToStringFunc="@(d => d?.GroupName ?? string.Empty )">
	@foreach (var group in _groupForTable)
	{
		<MudSelectItem T="DeppartModel" Value="@group">@group.GroupName</MudSelectItem>
	}
</MudSelect>

<MudText>@_currentDeppart.GroupName</MudText>

<MudSelect T="UsersForListModel" Label="@Localizer["group"]" Variant="Variant.Outlined"
		   @bind-Value="@_currentEstimate"
		   ToStringFunc="@(d => d.SurnameUser?? string.Empty )">
	@foreach (var item in _estimates)
	{
		<MudSelectItem T="UsersForListModel" Value="@item">@item.SurnameUser</MudSelectItem>
	}
</MudSelect>

<MudText>@_currentEstimate.SurnameUser</MudText>



<MudTable T="DrawingModel" Items="@_drawings" Filter="new Func<DrawingModel, bool>(FilterFuncCurrent)"  Bordered=true>
	<ToolBarContent>
		<MudSpacer />
		<MudTextField @bind-Value="searchString" Placeholder="@Localizer["search"]" Adornment="Adornment.Start" 
			AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>

	</ToolBarContent>
	@* 			<ColGroup> должен содержать столько элементов `<col>`, сколько столбцов (включая столбец с чекбоксами для мультиселекта) *@ 			
				<ColGroup>
		<col style="width: 1%" />
		<col style="width: 1%" />
		<col style="width: 27%" />
		<col />
		<col />
		<col />
		<col style="width: 17%" />
		<col style="width: 25%" />
	</ColGroup>
	<HeaderContent>
		<MudTh Style="@styleTableHeader"><MudTableSortLabel SortBy="new Func<DrawingModel, object>(x => x.DrawingPriority)">@Localizer["priority"]</MudTableSortLabel></MudTh>
		<MudTh Style="@styleTableHeader"><MudTableSortLabel SortBy="new Func<DrawingModel, object>(x => x.DrawingName)">@Localizer["drawingName"]</MudTableSortLabel></MudTh>
		<MudTh Style="@styleTableHeader">
			<MudTableSortLabel SortBy="new Func<DrawingModel, object>(x => x.DrawingDateOfAdmissionToDepartment)"
							   SortLabel="DrawingDateOfAdmissionToDepartment">@Localizer["dateOfAdmissionToDepartment"]</MudTableSortLabel>
		</MudTh>
		<MudTh Style="@styleTableHeader">
			<MudTableSortLabel SortBy="new Func<DrawingModel, object>(x => x.DrawingReleaseDateDepertment)"
							   SortLabel="DrawingReleaseDateDepertment">@Localizer["drawingReleaseDateDepertment"]</MudTableSortLabel>
		</MudTh>

		<MudTh Style="@styleTableHeader"><MudTableSortLabel SortBy="new Func<DrawingModel, object>(x => x.Group)">@Localizer["group"]</MudTableSortLabel></MudTh>
		<MudTh Style="@styleTableHeader"><MudTableSortLabel SortBy="new Func<DrawingModel, object>(x => x.Notes)">@Localizer["notes"]</MudTableSortLabel></MudTh>
	</HeaderContent>

	<RowTemplate>
		<MudTd style="@styleTableBody" DataLabel="@Localizer["priority"]">@context.DrawingPriority</MudTd>
		<MudTd Style="@styleTableBody" DataLabel="@Localizer["drawingName"]">@context.DrawingName</MudTd>
		<MudTd Style="@styleTableBody" DataLabel="@Localizer["dateOfAdmissionToDepartment"]">@(context.DrawingDateOfAdmissionToDepartment == null ? "" : Convert.ToDateTime(context.DrawingDateOfAdmissionToDepartment).ToString(Constants.DateFormat))</MudTd>
		<MudTd Style="@styleTableBody" DataLabel="@Localizer["drawingReleaseDateDepertment"]">@(context.DrawingReleaseDateDepertment == null ? "" : Convert.ToDateTime(context.DrawingReleaseDateDepertment).ToString(Constants.DateFormat))</MudTd>
		<MudTd Style="@styleTableBody" DataLabel="@Localizer["drawingReleaseDateBySchedule"]">@(context.DrawingReleaseDateBySchedule == null ? "" : Convert.ToDateTime(context.DrawingReleaseDateBySchedule).ToString(Constants.DateFormat))</MudTd>
		<MudTd Style="@styleTableBody" DataLabel="@Localizer["group"]">@(context.Group?.GroupName)</MudTd>
		<MudTd Style="@styleTableBody" DataLabel="@Localizer["group"]">@(context.Status?.StatusName)</MudTd>
		<MudTd Style="@styleTableBody" DataLabel="@Localizer["notes"]">@context.Notes</MudTd>

	</RowTemplate>

</MudTable>
